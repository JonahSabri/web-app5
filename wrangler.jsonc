{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app5",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "e81cbe8d-c5f9-4964-b17e-18a2904cad08","database_name": "web-app5" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "70a78ef9d461414994e01809de7f13bd" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
